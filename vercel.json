{
  "version": 2,
  "functions": {
    "api/analyze-plugin.js": {
      "maxDuration": 60
    }
  },
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/code.js",
      "destination": "/code.js"
    },
    {
      "source": "/ui.html",
      "destination": "/ui.html"
    }
  ]
}
